# Cutroom environment — copy to .env and fill in. Values below are names only.
# Client-visible vars must keep the VITE_ prefix; server vars are read via process.env.

# Supabase (project URL + anon/publishable key). In the dashboard enable the
# Email and Google auth providers; for Google also set the OAuth client id/secret
# and add this app's URL to Site URL + Redirect URLs.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase access (used by API routes / SSR).
# SERVICE_ROLE_KEY bypasses RLS — server only, never exposed to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auto-captions speech-to-text runs on ELEVENLABS_API_KEY (Scribe) — no separate provider.

# AI Studio (server-only). Blank disables the section with a clear in-app hint.
# MINIMAX_API_KEY enables Image + Video generation (video needs Pay-as-you-go).
# ELEVENLABS_API_KEY enables the Voices section AND auto-caption transcription (Scribe).
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=

# AI Assist + caption translation via OpenRouter chat completions (server-only).
# AI_SUGGEST_MODEL overrides the default free Nemotron model.
OPENROUTER_API_KEY=
AI_SUGGEST_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Direct Postgres connection for running Drizzle migrations (drizzle.config.ts)
DB_MIGRATION_URL=
