# Cutroom environment — copy to .env and fill in. Values below are names only.
# Client-visible vars must keep the VITE_ prefix; server vars are read via process.env.

# Supabase (project URL + anon/publishable key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase access (used by API routes / SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Silent sign-in fallback (only used if Supabase anonymous sign-in is disabled).
# Create one demo user in Supabase, then set these; leave blank to rely on anonymous sign-in.
VITE_DEMO_AUTH_EMAIL=
VITE_DEMO_AUTH_PASSWORD=

# AI features (optional). Leave OPENAI_API_KEY blank to disable transcription/translation.
OPENAI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# Direct Postgres connection for running Drizzle migrations (drizzle.config.ts)
DB_MIGRATION_URL=
