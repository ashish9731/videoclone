# Cutroom environment — copy to .env and fill in. Values below are names only.
# Client-visible vars must keep the VITE_ prefix; server vars are read via process.env.

# Supabase (project URL + anon/publishable key). In the dashboard enable the
# Email and Google auth providers; for Google also set the OAuth client id/secret
# and add this app's URL to Site URL + Redirect URLs.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase access (used by API routes / SSR).
# SERVICE_ROLE_KEY bypasses RLS — server only, never exposed to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI features (optional). Leave OPENAI_API_KEY blank to disable transcription/translation.
OPENAI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# Direct Postgres connection for running Drizzle migrations (drizzle.config.ts)
DB_MIGRATION_URL=
